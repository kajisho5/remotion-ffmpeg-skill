{
  "about": "Agent evals: a natural-language request, run by an agent that has this skill (SKILL.md) and ffmpeg-skill; graded on the files it leaves and its final reply (grade.py). Media from make_fixtures.py. Video checks pass when any non-fixture video the agent made meets them (agents name files freely).",
  "tasks": [
    {
      "id": "captions-youtube",
      "prompt": "Put animated captions from talk.srt on talk.mp4 and make it ready to upload to YouTube.",
      "checks": [
        {
          "type": "file",
          "glob": "*.timeline.json",
          "captions": 2
        },
        {
          "type": "video",
          "glob": "*.mp4",
          "width": 1920,
          "height": 1080
        },
        {
          "type": "reply_mentions",
          "any": [
            "sheet.png",
            "Look:"
          ]
        },
        {
          "type": "source_untouched",
          "file": "talk.mp4"
        }
      ]
    },
    {
      "id": "jumpcut-reels-ja",
      "prompt": "talk.mp4 の無音をカットしてテンポよくして、talk_ja.srt の字幕も付けて、Instagram のリール用にして。",
      "checks": [
        {
          "type": "any_of",
          "routes": [
            {
              "name": "remotion-ffmpeg-skill",
              "checks": [
                {
                  "type": "file",
                  "glob": "*.timeline.json",
                  "captions": 2
                }
              ]
            },
            {
              "name": "ffmpeg-skill alone",
              "checks": [
                {
                  "type": "reply_mentions",
                  "any": [
                    "クロップ",
                    "切り抜",
                    "crop",
                    "端",
                    "blur",
                    "ぼかし"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "video",
          "glob": "*.mp4",
          "width": 1080,
          "height": 1920
        },
        {
          "type": "video",
          "glob": "*.mp4",
          "max_duration": 7.0
        },
        {
          "type": "reply_mentions",
          "any": [
            "sheet.png",
            "Look:",
            "コマ"
          ]
        }
      ],
      "note": "ffmpeg-skill's Reels template alone is valid if the reply says the 16:9 sides were cropped."
    },
    {
      "id": "beat-montage",
      "prompt": "Make a montage of music.mp4 that cuts to the beat.",
      "checks": [
        {
          "type": "file",
          "glob": "*.timeline.json",
          "beats_usable": true
        },
        {
          "type": "video",
          "glob": "*.mp4",
          "min_duration": 11.5
        }
      ]
    },
    {
      "id": "lower-third-asks-for-text",
      "prompt": "Add a lower third with the speaker's name to talk.mp4.",
      "checks": [
        {
          "type": "reply_mentions",
          "any": [
            "name",
            "名前",
            "?",
            "？"
          ]
        },
        {
          "type": "no_file",
          "glob": "*Titled*.mp4",
          "unless_reply_has": [
            "Sample",
            "placeholder",
            "仮"
          ]
        }
      ],
      "note": "The name is not given: the skill must ask (or clearly mark a placeholder), never invent a person."
    },
    {
      "id": "plain-trim-not-this-skill",
      "prompt": "Trim the first 2 seconds off talk.mp4.",
      "checks": [
        {
          "type": "no_file",
          "glob": "*.timeline.json"
        },
        {
          "type": "no_dir",
          "glob": "*/src/index.ts"
        }
      ],
      "note": "No graphics involved: a plain cut belongs to ffmpeg-skill, not a Remotion render."
    },
    {
      "id": "highlights-square",
      "prompt": "Make a square highlight reel of the best 2 moments of music.mp4 with the title 'Sample Reel'.",
      "checks": [
        {
          "type": "file",
          "glob": "*.timeline.json",
          "min_highlights": 1
        },
        {
          "type": "video",
          "glob": "*.mp4",
          "square": true
        }
      ]
    },
    {
      "id": "graphics-layer-for-editor",
      "prompt": "I'm finishing talk.mp4 in Premiere. Give me the captions from talk.srt as a separate transparent layer I can put on top.",
      "checks": [
        {
          "type": "file",
          "glob": "*.timeline.json",
          "captions": 2
        },
        {
          "type": "video",
          "glob": "*.mov",
          "alpha": true
        },
        {
          "type": "source_untouched",
          "file": "talk.mp4"
        }
      ]
    },
    {
      "id": "join-then-titles",
      "prompt": "Join talk.mp4 and music.mp4 into one video and put a title card 'Part 1' and 'Part 2' at the start of each.",
      "checks": [
        {
          "type": "any_of",
          "routes": [
            {
              "name": "remotion-ffmpeg-skill",
              "checks": [
                {
                  "type": "file",
                  "glob": "*.timeline.json",
                  "clips": 2
                }
              ]
            },
            {
              "name": "ffmpeg-skill alone",
              "checks": [
                {
                  "type": "reply_mentions",
                  "any": [
                    "Part 1"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "video",
          "glob": "*.mp4",
          "min_duration": 19.5
        }
      ],
      "note": "ffmpeg-skill join + title templates alone is a valid route."
    },
    {
      "id": "karaoke-from-words",
      "prompt": "Make karaoke-style captions for talk.mp4 where each word lights up as it's spoken. The word timings from my transcription are in talk_words.json.",
      "checks": [
        {
          "type": "any_of",
          "routes": [
            {
              "name": "remotion-ffmpeg-skill",
              "checks": [
                {
                  "type": "file",
                  "glob": "*.timeline.json",
                  "min_words": 5
                }
              ]
            },
            {
              "name": "ffmpeg-skill alone",
              "checks": [
                {
                  "type": "reply_mentions",
                  "any": [
                    "talk_words.json",
                    "words.json"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "video",
          "glob": "*.mp4",
          "min_duration": 7.5,
          "max_duration": 8.5
        }
      ],
      "note": "ffmpeg-skill caption.py --karaoke alone is a valid route."
    },
    {
      "id": "reel-keep-whole-frame",
      "prompt": "talk.mp4 に talk_ja.srt の字幕を付けて、Instagram のリール用にして。横長の画面は切らずに全部見せて。",
      "checks": [
        {
          "type": "video",
          "glob": "*.mp4",
          "width": 1080,
          "height": 1920
        },
        {
          "type": "any_of",
          "routes": [
            {
              "name": "remotion-ffmpeg-skill",
              "checks": [
                {
                  "type": "file",
                  "glob": "*.timeline.json",
                  "captions": 2
                }
              ]
            },
            {
              "name": "ffmpeg-skill alone",
              "checks": [
                {
                  "type": "reply_mentions",
                  "any": [
                    "ぼかし",
                    "blur",
                    "余白",
                    "上下",
                    "pad",
                    "黒帯"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "source_untouched",
          "file": "talk.mp4"
        }
      ],
      "note": "The whole 16:9 picture must stay: a blurred or padded fill, never a centre crop."
    },
    {
      "id": "long-footage-captions",
      "prompt": "Put animated captions from lecture.srt on lecture.mp4. It's long footage with only a few captions, so keep the render as quick as you can.",
      "checks": [
        {
          "type": "video",
          "glob": "*.mp4",
          "min_duration": 59.5
        },
        {
          "type": "any_of",
          "routes": [
            {
              "name": "remotion-ffmpeg-skill --sparse",
              "checks": [
                {
                  "type": "file",
                  "glob": "*.timeline.json",
                  "captions": 3
                },
                {
                  "type": "reply_mentions",
                  "any": [
                    "sparse",
                    "stretch"
                  ]
                }
              ]
            },
            {
              "name": "ffmpeg-skill alone",
              "checks": [
                {
                  "type": "no_dir",
                  "glob": "*/src/index.ts"
                },
                {
                  "type": "reply_mentions",
                  "any": [
                    "caption.py",
                    "ffmpeg-skill"
                  ]
                }
              ]
            }
          ]
        }
      ],
      "note": "Either only the captioned stretches are drawn (--sparse) or no browser render at all."
    },
    {
      "id": "caption-look-options",
      "prompt": "Put animated captions from talk.srt on talk.mp4, with a red accent and captions a bit bigger than the default.",
      "checks": [
        {
          "type": "video",
          "glob": "*.mp4",
          "width": 1280,
          "height": 720
        },
        {
          "type": "any_of",
          "routes": [
            {
              "name": "remotion-ffmpeg-skill",
              "checks": [
                {
                  "type": "file",
                  "glob": "*.timeline.json",
                  "captions": 2
                },
                {
                  "type": "options_file",
                  "keys": [
                    "accent",
                    "captionSize"
                  ]
                }
              ]
            },
            {
              "name": "ffmpeg-skill alone",
              "checks": [
                {
                  "type": "no_dir",
                  "glob": "*/src/index.ts"
                },
                {
                  "type": "reply_mentions",
                  "any": [
                    "red",
                    "赤"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "source_untouched",
          "file": "talk.mp4"
        }
      ],
      "note": "The look comes from an options file with real keys (a typo is refused by render.py; the agent must fix it, not drop it)."
    }
  ]
}
